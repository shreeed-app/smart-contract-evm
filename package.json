{
  "name": "smart-contract-evm",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "node": "hardhat node",
    "compile": "hardhat compile",
    "deploy": "hardhat ignition deploy ignition/modules/PaymentGateway.ts --network localhost",
    "test": "hardhat test",
    "lint": "biome check . && eslint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write . && prettier --write 'contracts/**/*.sol'",
    "dependencies:install": "sfw bun install",
    "dependencies:update": "bunx npm-check-updates -u"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.9.0",
    "bun": ">=1.3.4"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@nomicfoundation/hardhat-ignition": "3.1.7",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@nomicfoundation/hardhat-viem": "3.0.9",
    "@nomicfoundation/ignition-core": "3.1.7",
    "@types/chai": "5.2.3",
    "@types/node": "25.9.2",
    "@wagmi/core": "3.5.0",
    "chai": "6.2.2",
    "eslint": "10.4.1",
    "ethers": "6.16.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "globals": "17.6.0",
    "hardhat": "3.9.0",
    "jiti": "2.7.0",
    "prettier": "3.8.4",
    "prettier-plugin-solidity": "2.3.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "viem": "2.52.2"
  }
}
